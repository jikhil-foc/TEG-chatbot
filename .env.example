APP_NAME=TEG Chatbot API
DEBUG=true
HOST=0.0.0.0
PORT=8000

# OpenAI (required for embeddings and QA)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Cohere (required for reranking)
COHERE_API_KEY=
# COHERE_RERANK_MODEL=rerank-v3.5

# Database Configuration (required for incremental ingestion)
# DB_HOST/DB_PORT below are for host-side tools (pgAdmin, clear_db.py) against Compose Postgres.
# Docker Compose overrides DB_HOST=postgres and DB_PORT=5432 inside the backend container.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=admin
DB_DATABASE=teg_chatbot

# Qdrant vector database (required for retrieval)
# Docker Compose overrides this to http://qdrant:6333 automatically.
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# LangSmith observability (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=teg-chatbot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # EU: https://eu.api.smith.langchain.com
